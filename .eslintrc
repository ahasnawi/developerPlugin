{
  "env": {
    "browser": true,
    "es6": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "sourceType": "module",
    "ecmaVersion": 2020
  },
  "rules": {
    "semi": [
      "error",
      "always"
    ],
    "no-console": [
      "off"
    ]
  },
  "globals": {
    "monaco": true,
    "require": true
  }
}